# Variables de entorno del frontend.
# Copia este archivo como .env y ajusta los valores. El script
# scripts/set-env.mjs las lee antes de `npm start`, `npm run build` y `npm test`
# y genera src/environments/environment.ts.

# URL base de la API REST (Express)
NG_APP_API_URL=http://localhost:8000/api

# URL del servidor de tiempo real (Socket.IO). Comparte puerto con la API.
NG_APP_SOCKET_URL=http://localhost:8000
