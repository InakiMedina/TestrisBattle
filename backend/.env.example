# Server configuration
PORT=8000
NODE_ENV=development

# Authentication configuration
JWT_SECRET=iamaveryunsafesecret
JWT_EXPIRES_IN=3h
CORS_ORIGIN=http://localhost:4200

# Database configuration
MONGODB_URL=
MONGO_USERNAME=
MONGO_PASSWORD=

# Seed data configuration
SEED_ADMIN_PASSWORD=ADMIN1234
SEED_USER_PASSWORD=USER1234

# AWS S3 configuration (archivos de los usuarios: fotos de perfil y fondos)
# Son opcionales: si faltan, el servidor arranca igual, pero no se pueden subir
# ni mostrar fotos de perfil ni fondos personalizados (se usan los de defecto).
# El usuario o rol de las llaves necesita s3:PutObject, s3:GetObject y
# s3:DeleteObject sobre el bucket.
# En AWS Academy (Learner Lab) las credenciales son temporales: copia las tres
# (incluido AWS_SESSION_TOKEN) desde "AWS Details" cada vez que inicies el lab.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET_NAME=tetrisbattle-main-s3-bucket-users-files
